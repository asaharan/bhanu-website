# "local" reads/writes .data/bookings.db on disk — no AWS credentials needed for local dev.
# Unset (or any other value) to use the real S3-backed store, e.g. in production.
STORAGE_DRIVER=local

# --- Required when STORAGE_DRIVER is not "local" ---
S3_BUCKET_NAME=
S3_DB_KEY=bookings.db
# --- AWS region/credentials for S3 and SES (also needed for email in local mode) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Admin (/admin) ---
# A long random secret used to sign/encrypt the admin session cookie. Must be at least 32 characters.
SESSION_SECRET=
# The password required to sign in at /admin/login.
ADMIN_PASSWORD=

# --- SES booking notifications (required to send email) ---
# Verify this address or its domain in SES in AWS_REGION.
FROM_EMAIL=
# In the SES sandbox, verify this recipient as well.
NOTIFICATION_EMAIL=
